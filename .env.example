# Environment Variables for Bill Processor
# Copy this file to .env and fill in your values
# NEVER commit the .env file to git!

# Google Places API Key (from Google Cloud Console)
# See GOOGLE_API_SETUP.md for setup instructions
GOOGLE_PLACES_API_KEY=

# Uncomment and set if you want to override default database path
# GNUCASH_DB_PATH=D:\path\to\your\database.gnucash
